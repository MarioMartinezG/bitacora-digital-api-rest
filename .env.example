# =============================================================
# BITACORA DIGITAL - Variables de entorno requeridas
# -------------------------------------------------------------
# 1. Copia este archivo:  cp .env.example .env
# 2. Completa los valores en .env
# 3. NUNCA subas .env al repositorio (.gitignore ya lo excluye)
# =============================================================

# ── Base de datos ──────────────────────────────────────────────────────────────
# Elige UNA opción según dónde corra PostgreSQL:
#
# a) BD dockerizada en el mismo docker-compose (perfil local-db):
#    DB_URL=jdbc:postgresql://postgres:5432/teia_db
#
# b) BD en un servidor/servicio externo:
#    DB_URL=jdbc:postgresql://<host-externo>:5432/teia_db
#
# c) BD en el mismo servidor pero sin Docker (p. ej. instalación nativa):
#    DB_URL=jdbc:postgresql://host.docker.internal:5432/teia_db
#    (fuera de Docker usa localhost en lugar de host.docker.internal)
#
DB_URL=jdbc:postgresql://localhost:5432/teia_db

DB_USERNAME=teia_user
DB_PASSWORD=teia_password

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generar un secreto seguro con: openssl rand -base64 64
JWT_SECRET=<reemplazar-con-valor-seguro>
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400

# ── Servicio tutor IA ──────────────────────────────────────────────────────────
# Elige UNA opción según dónde corra el servicio de IA:
#
# a) Servicio dockerizado accesible por red de Docker:
#    TUTOR_SERVICE_URL=http://<nombre-servicio-docker>:8000
#
# b) Servicio en un servidor/endpoint externo:
#    TUTOR_SERVICE_URL=http://<host-externo>:8000
#
# c) Servicio en el mismo servidor pero sin Docker:
#    TUTOR_SERVICE_URL=http://host.docker.internal:8000
#    (fuera de Docker usa http://localhost:8000)
#
TUTOR_SERVICE_URL=http://localhost:8000
TUTOR_SERVICE_TIMEOUT=120000

# ── Correo SMTP ────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=correo@ejemplo.com
# Usar App Password de Gmail (no la contraseña de la cuenta)
MAIL_PASSWORD=<app-password-de-gmail>

# ── Scheduler de notificaciones ────────────────────────────────────────────────
# IMPORTANTE: Docker corre en UTC.
# Colombia es UTC-5, por lo tanto 8:00 AM Colombia = 13:00 UTC.
# Valor para producción (servidor en UTC):
NOTIFICACIONES_SCHEDULER_CRON=0 0 13 * * ?
# Valor para desarrollo local (JVM en horario Colombia):
# NOTIFICACIONES_SCHEDULER_CRON=0 0 8 * * ?
