# =============================================================
# BITACORA DIGITAL - Variables de entorno requeridas
# -------------------------------------------------------------
# 1. Copia este archivo:  cp .env.example .env
# 2. Completa los valores en .env
# 3. NUNCA subas .env al repositorio (.gitignore ya lo excluye)
# =============================================================

# ── Base de datos ──────────────────────────────────────────────────────────────
# Desarrollo local (con docker-compose):
DB_URL=jdbc:postgresql://localhost:5432/teia_db

# Cloud Run + Cloud SQL (reemplaza PROJECT, REGION, INSTANCE):
# DB_URL=jdbc:postgresql:///teia_db?cloudSqlInstance=PROJECT:REGION:INSTANCE&socketFactory=com.google.cloud.sql.postgres.SocketFactory&ipTypes=PUBLIC,PRIVATE

DB_USERNAME=teia_user
DB_PASSWORD=teia_password

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generar un secreto seguro con: openssl rand -base64 64
JWT_SECRET=<reemplazar-con-valor-seguro>
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400

# ── Servicio tutor IA ──────────────────────────────────────────────────────────
TUTOR_SERVICE_URL=http://localhost:8000
TUTOR_SERVICE_TIMEOUT=120000

# ── Correo SMTP ────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=correo@ejemplo.com
# Usar App Password de Gmail (no la contraseña de la cuenta)
MAIL_PASSWORD=<app-password-de-gmail>

# ── Scheduler de notificaciones ────────────────────────────────────────────────
# IMPORTANTE: Cloud Run corre en UTC.
# Colombia es UTC-5, por lo tanto 8:00 AM Colombia = 13:00 UTC.
# Valor para produccion (Cloud Run):
NOTIFICACIONES_SCHEDULER_CRON=0 0 13 * * ?
# Valor para desarrollo local (si la JVM corre en horario Colombia):
# NOTIFICACIONES_SCHEDULER_CRON=0 0 8 * * ?
